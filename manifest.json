{
  "manifest_version": 3,
  "name": "WZ Conecta — Grupo Cometa",
  "version": "2.8.1",
  "description": "Conecta o WhatsApp Web ao CRM corporativo: cria leads e registra conversas e atividades. Uso interno do Grupo Cometa.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "identity", "tabs"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://wzapi.viacometa.com.br/*",
    "https://cometa.my.salesforce.com/*",
    "https://cometa.lightning.force.com/*",
    "https://login.salesforce.com/*",
    "https://*.salesforce.com/*",
    "https://*.force.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "fonts/Geist-Regular.woff2",
        "fonts/Geist-SemiBold.woff2",
        "fonts/GeistMono-Regular.woff2"
      ],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "action": {
    "default_title": "WZ Conecta — Abrir WhatsApp Web",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
